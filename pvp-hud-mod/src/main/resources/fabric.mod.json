{
  "schemaVersion": 1,
  "id": "pvphudmod",
  "version": "${version}",
  "name": "PvP HUD Mod",
  "description": "A modern PvP HUD display mod for Minecraft 1.21 with health bar and armor display",
  "authors": [
    "free-Game-idk"
  ],
  "contact": {
    "homepage": "https://github.com/free-Game-idk/1.12-eaglercraftx",
    "sources": "https://github.com/free-Game-idk/1.12-eaglercraftx"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.pvphud.PvPHudMod"
    ],
    "client": [
      "com.pvphud.client.PvPHudClient"
    ]
  },
  "mixins": [
    "pvphud.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
